{
  "name": "lims-platform-frontend",
  "version": "0.1.0",
  "license": "SEE LICENSE IN ../LICENSE",
  "private": true,
  "type": "module",
  "scripts": {
    "predev": "npm run verify:template",
    "dev": "vite",
    "typecheck": "vue-tsc --noEmit",
    "prebuild": "npm run verify:template && npm run verify:components",
    "build": "npm run typecheck && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "check:styles": "node scripts/check-styles.mjs",
    "verify:template": "node scripts/verify-template.mjs",
    "verify:components": "node scripts/verify-component-adapters.mjs",
    "test:platform": "vitest run --config vitest.platform.config.ts",
    "test:ui": "vitest run --config vitest.ui.config.ts"
  },
  "dependencies": {
    "@popperjs/core": "2.11.8",
    "@tabler/core": "^1.7.5",
    "@tabler/icons-webfont": "^3.52.0",
    "bootstrap": "5.3.8",
    "crypto-js": "^4.2.0",
    "filepond": "4.32.12",
    "flatpickr": "^4.6.13",
    "gsap": "^3.15.0",
    "pdf-lib": "1.17.1",
    "pdfmake": "0.2.20",
    "pinia": "^3.0.3",
    "vue": "^3.5.21",
    "vue-router": "^4.5.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.55.0",
    "@types/bootstrap": "^5.2.10",
    "@types/node": "^22.18.0",
    "@types/pdfmake": "0.2.12",
    "@vitejs/plugin-vue": "^6.0.1",
    "@vue/test-utils": "^2.4.6",
    "fake-indexeddb": "6.2.4",
    "jsdom": "^26.1.0",
    "postcss": "^8.5.28",
    "sass": "1.77.8",
    "typescript": "~5.9.2",
    "vite": "^7.1.5",
    "vitest": "^3.2.4",
    "vue-tsc": "^3.0.6"
  }
}
